# ===============================================================
# Dhaniti backend — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to version control.
# ===============================================================

# ---- Database -------------------------------------------------
# SQLite database file (default: ../dhaniti_loans.db at project root)
# DATABASE_PATH=sqlite:///./dhaniti_loans.db

# ---- Security -------------------------------------------------
# REQUIRED IN PRODUCTION. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_secret

# Session lifetimes
JWT_TTL_HOURS=8
JWT_TTL_REMEMBER_HOURS=720
RESET_TOKEN_TTL_MINUTES=15

# Set to true in production to enforce real secrets
# PRODUCTION=false

# ---- CORS -----------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- OAuth: Google ---------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {OAUTH_REDIRECT_BASE}/auth/google/callback
GOOGLE_CLIENT_ID=change_this
GOOGLE_CLIENT_SECRET=change_this

# ---- OAuth: GitHub ---------------------------------------------
# Create credentials at https://github.com/settings/developers
# Authorization callback URL: {OAUTH_REDIRECT_BASE}/auth/github/callback
GITHUB_CLIENT_ID=change_this
GITHUB_CLIENT_SECRET=change_this

# Base URL where this backend is reachable (used to build callback URLs)
OAUTH_REDIRECT_BASE=http://localhost:5000

# Where to redirect the browser after OAuth login (your React app)
FRONTEND_URL=http://localhost:5173

# ---- OTP / Email (SMTP) ---------------------------------------
# Any SMTP provider works (Gmail, SendGrid, Resend, Mailgun, SES...).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true,
#        SMTP_USERNAME=you@gmail.com, SMTP_PASSWORD=<app password>
SMTP_HOST=change_this
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=change_this
SMTP_PASSWORD=change_this
SMTP_FROM=Dhaniti Dashboard <no-reply@yourdomain.com>

# ---- OTP policy -----------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- Rate limiting --------------------------------------------
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW_SECONDS=900
OTP_SEND_RATE_MAX=3
OTP_SEND_RATE_WINDOW_SECONDS=600
