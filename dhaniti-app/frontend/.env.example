# Frontend environment configuration (Vite)
# Copy to `.env` for local overrides. All values are OPTIONAL —
# the app talks to the same origin by default (works with the
# Vite dev proxy and with the FastAPI-served production build).

# Backend URL used ONLY by the Vite dev-server proxy:
#   npm run dev  →  /api & /auth requests are forwarded here.
API_PROXY_TARGET=http://localhost:5000
