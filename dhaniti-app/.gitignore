# ===============================================================
# Dhaniti — .gitignore
# ===============================================================

# --- Secrets & environment (NEVER commit real .env files) ------
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local

# --- Python ----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
ENV/
.python-version

# --- Node / frontend -------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Built frontend served by the backend ----------------------
backend/static/

# --- Logs & email outbox ---------------------------------------
*.log
logs/
backend/logs/
backend/logs/emails/*.eml

# --- Database backups (keep the live DB out too if you prefer) -
*.backup-*.db
*.db.bak
backend/.server.pid
backend/.flask.pid

# SQLite side files
*.db-shm
*.db-wal

# --- Testing / coverage ----------------------------------------
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# --- Editors / OS ----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Misc ------------------------------------------------------
*.tmp
*.temp
